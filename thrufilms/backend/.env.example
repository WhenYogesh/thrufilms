# Database — Default uses SQLite (no setup needed)
# For PostgreSQL: postgresql://user:password@localhost/thrufilms
DATABASE_URL=sqlite:///./thrufilms.db

# JWT Secret — Change this to a long random string in production
SECRET_KEY=your-super-secret-key-change-me-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Cloudinary (optional — stub mode works without these)
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# CORS
FRONTEND_URL=http://localhost:5173
